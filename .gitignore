# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Data (keep folder structure via .gitkeep, ignore actual data files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Outputs
figures/*
!figures/.gitkeep
results/*
!results/.gitkeep

# Logs
*.log
